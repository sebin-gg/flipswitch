# Optional: enable the smart (LLM) ADR engine.
# Without a key the agent uses the deterministic heuristic engine, and the
# demo/tests run fully offline.
ADR_API_KEY=
# Any model exposed by an OpenAI-compatible /chat/completions endpoint.
ADR_MODEL=gpt-4.1
# Change this for Azure OpenAI, OpenRouter, Ollama, vLLM, etc.
ADR_LLM_BASE_URL=https://api.openai.com/v1
